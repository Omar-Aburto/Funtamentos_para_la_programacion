# ✏️ COMPLETA: la razón p90/p10 (Semana 4) como función.
razon_90_10 <- function(x) {
percentiles <- quantile(x, probs = c(0.10, 0.90), na.rm = TRUE)
unname(percentiles[2] / percentiles[1])
