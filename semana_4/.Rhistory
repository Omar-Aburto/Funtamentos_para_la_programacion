mean(trabajadores$ingreso)                            # ingreso promedio
mean(trabajadores$ingreso[trabajadores$educ >= 12])   # solo educ >= 12 años
mean(mis_gastos$monto[mis_gastos$monto > 1700])
mean(mis_gastos$monto[mis_gastos$excencial==TRUE])
