) +
labs(
title = "Hombres ganan más que las mujeres a igual nivel educativo", # Título tipo hallazgo
x = "Años de escolaridad",
y = "Ingreso mensual",
color = "Género",
caption = "Fuente: CASEN"
) +
theme_minimal()
theme(plot.title = element_text(face = "bold"))
# -------------------------------------------------------------------------
# Gráfico 1 · CASEN: educación e ingreso por género
# -------------------------------------------------------------------------
ggplot(casen, aes(x = educ, y = ingreso, color = genero)) +     # color global: hereda punto y recta
geom_point(alpha = 0.6, size = 2) +                           # puntos semitransparentes
geom_smooth(method = "lm", se = FALSE) +                      # recta de regresión lineal por género
scale_color_viridis_d(begin = 0.2, end = 0.8) +               # paleta accesible (discreta)
scale_y_continuous(
labels = label_currency(big.mark = ".", decimal.mark = ",") # eje en pesos chilenos
) +
labs(
title = "Hombres ganan más que las mujeres a igual nivel educativo", # Título tipo hallazgo
x = "Años de escolaridad",
y = "Ingreso mensual",
color = "Género",
caption = "Fuente: CASEN"
) +
theme_minimal()
ggplot(casen, aes(x = educ, y = ingreso, color = genero))
geom_point(alpha = 0.6, size = 2)
ggplot(casen, aes(x = educ, y = ingreso, color = genero)) +     # color global: hereda punto y recta
geom_point(alpha = 0.6, size = 2)
ggplot(casen, aes(x = educ, y = ingreso, color = genero)) +     # color global: hereda punto y recta
geom_point(alpha = 0.6, size = 2) +                           # puntos semitransparentes
geom_smooth(method = "lm", se = FALSE)
ggplot(casen, aes(x = educ, y = ingreso, color = genero)) +     # color global: hereda punto y recta
geom_point(alpha = 0.6, size = 2) +                           # puntos semitransparentes
geom_smooth(method = "lm", se = FALSE) +                      # recta de regresión lineal por género
scale_color_viridis_d(begin = 0.2, end = 0.8)
ggplot(casen, aes(x = educ, y = ingreso, color = genero)) +     # color global: hereda punto y recta
geom_point(alpha = 0.6, size = 2) +                           # puntos semitransparentes
geom_smooth(method = "lm", se = FALSE) +                      # recta de regresión lineal por género
scale_color_viridis_d(begin = 0.2, end = 0.8) +               # paleta accesible (discreta)
scale_y_continuous(
labels = label_currency(big.mark = ".", decimal.mark = ",") # eje en pesos chilenos
) +
labs(
title = "Hombres ganan más que las mujeres a igual nivel educativo", # Título tipo hallazgo
x = "Años de escolaridad",
y = "Ingreso mensual",
color = "Género",
caption = "Fuente: CASEN"
) +
theme_minimal()
theme(plot.title = element_text(face = "bold"))
# 2. Creación del gráfico
ggplot(salario_largo, aes(x = anio, y = pesos, color = serie, linetype = serie)) + # Mapea color y tipo de línea a "serie"
geom_line(linewidth = 1.2) +                                            # Dibuja las líneas de tiempo
scale_color_manual(values = c("Nominal" = "#e69b0a", "Real" = "#223c6a")) + # Aplica paleta personalizada
scale_x_continuous(limits = c(2014, 2027)) +                            # Margen fijo para el texto[cite: 3]
scale_y_continuous(
labels = label_currency(big.mark = ".", decimal.mark = ",")           # Formato chileno[cite: 4]
) +
labs(
title = "El poder adquisitivo (real) sube más lento que el salario nominal",
x = "Año", y = "Monto en pesos", color = "Serie"
) +
theme_minimal() +
theme(plot.title = element_text(face = "bold"), legend.position = "none") +
# Etiquetas directas con el estilo del Bloque E de la Semana 10
geom_text(data = filter(salario_largo, anio == 2025),
aes(label = serie), hjust = -0.2)
# 1. Transformación de datos a formato largo
salario_largo <- salario |>
mutate(Real = salario_minimo / ipc * 100) |>                            # Calcula el salario real (base 2010)
select(anio, Nominal = salario_minimo, Real) |>                         # Selecciona las columnas a usar
pivot_longer(cols = c(Nominal, Real), names_to = "serie", values_to = "pesos") # Pasa de columnas anchas a formato largo
# 2. Creación del gráfico
ggplot(salario_largo, aes(x = anio, y = pesos, color = serie, linetype = serie)) + # Mapea color y tipo de línea a "serie"
geom_line(linewidth = 1.2) +                                            # Dibuja las líneas de tiempo
scale_color_manual(values = c("Nominal" = "#e69b0a", "Real" = "#223c6a")) + # Aplica paleta personalizada
scale_x_continuous(limits = c(2014, 2027)) +                            # Margen fijo para el texto[cite: 3]
scale_y_continuous(
labels = label_currency(big.mark = ".", decimal.mark = ",")           # Formato chileno[cite: 4]
) +
labs(
title = "El poder adquisitivo (real) sube más lento que el salario nominal",
x = "Año", y = "Monto en pesos", color = "Serie"
) +
theme_minimal() +
theme(plot.title = element_text(face = "bold"), legend.position = "none") +
# Etiquetas directas con el estilo del Bloque E de la Semana 10
geom_text(data = filter(salario_largo, anio == 2025),
aes(label = serie), hjust = -0.2)
# 1. Crear las etiquetas para sexo y categoría ocupacional (como en S10S2)
ene_grafico3 <- ene |>
mutate(
sexo = ifelse(sexo == 1, "Hombre", "Mujer"),
categoria = case_when(
categoria_ocupacion == 3 ~ "Asal. privado",
categoria_ocupacion == 4 ~ "Asal. público",
categoria_ocupacion == 2 ~ "Cuenta propia",
TRUE                     ~ "Otras"
)
)
# 2. Crear el gráfico de barras apiladas al 100%
ggplot(ene_grafico3, aes(x = sexo, fill = categoria, weight = fact_cal)) +
geom_bar(position = "fill") +                                       # position = "fill" hace que sumen 100%
scale_fill_brewer(palette = "Set2") +                               # Paleta accesible enseñada en clases
scale_y_continuous(labels = label_percent()) +                      # Eje Y en formato de porcentaje
labs(
title = "Mujeres tienen mayor participación en el sector público que los hombres", # Hallazgo principal
x = NULL,
y = "Proporción",
fill = "Categoría ocupacional",
caption = "Fuente: ENE, mayo-julio 2026 (datos ponderados)"
) +
theme_minimal() +
theme(plot.title = element_text(face = "bold"))
ene_grafico3 |>
group_by(sexo, categoria) |>
summarise(pob = sum(fact_cal), .groups = "drop") |>
group_by(sexo) |>
mutate(pct = round(100 * pob / sum(pob), 1))
ene_grafico3 |>
group_by(sexo, categoria) |>
summarise(pob = sum(fact_cal), .groups = "drop") |>
group_by(sexo) |>
mutate(pct = round(100 * pob / sum(pob), 1))
# Fundamentos de Programación para Análisis Económico
#
# Autor: Omar Aburto
# Fecha: 2026-11-03
#
# Objetivo: Analizar la distribución del ingreso (CASEN) y la informalidad
# laboral (ENE), justificando la elección de geometrías y componiendo una
# figura final con patchwork.
# =============================================================================
# 1. Carga de librerías
library(ggplot2)
library(dplyr)
library(patchwork)
library(scales)
library(ggrepel)
# Carga y limpieza
casen <- read.csv("data/raw/casen_reducido.csv") |> filter(!is.na(ingreso))
ene <- read.csv2("data/raw/ene-2026-06-mjj.csv") |> filter(activ == 1)
regiones <- c("Tarapacá", "Antofagasta", "Atacama", "Coquimbo", "Valparaíso",
"O'Higgins", "Maule", "Biobío", "La Araucanía", "Los Lagos",
"Aysén", "Magallanes", "Metropolitana", "Los Ríos",
"Arica y Parinacota", "Ñuble")
ocupados <- ene |>
mutate(informal   = ocup_form == 2,
mujer      = sexo == 2,
region_txt = regiones[region])
# -------------------------------------------------------------------------
# Gráfico 1 · Scatter CASEN
# -------------------------------------------------------------------------
grafico_1 <- ggplot(casen, aes(x = educ, y = ingreso, color = genero)) + # Datos y variables
geom_point(size = 2, alpha = 0.7) +                                    # Dibuja los puntos semitransparentes
scale_color_manual(values = c("F" = "#e69b0a", "M" = "#223c6a")) +     # Fija colores manuales (dorado y azul institucional)[cite: 4, 6]
scale_y_continuous(
labels = label_currency(big.mark = ".", decimal.mark = ",")          # Eje Y en pesos chilenos[cite: 4]
) +
labs(
title = "A mayor educación, mayor ingreso",                          # Título con el hallazgo[cite: 3]
x = "Años de escolaridad",                                           # Etiqueta del eje X
y = NULL,                                                            # Oculta la etiqueta del eje Y (ya se entiende por el $)
color = NULL,                                                        # Oculta el título de la leyenda
caption = "Fuente: CASEN (subconjunto)"                              # Fuente de los datos[cite: 1]
) +
theme_minimal(base_size = 13) +                                        # Tema limpio sin chart junk[cite: 4]
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),         # Título principal en negrita y color azul[cite: 4]
legend.position = "bottom"                                           # Mueve la leyenda abajo[cite: 4]
)
grafico_1                                                                # Imprime el gráfico en pantalla[cite: 3]
# -------------------------------------------------------------------------
# Gráfico 2 · Barras de informalidad por región (ENE)
# -------------------------------------------------------------------------
# 1. Preparar los datos y calcular promedios ponderados
inf_region <- ocupados |>
group_by(region_txt) |>                                            # Agrupa por región
summarise(total = 100 * weighted.mean(informal, fact_cal))         # Calcula el % ponderado por región[cite: 3]
inf_nacional <- 100 * weighted.mean(ocupados$informal, ocupados$fact_cal) # Calcula el % ponderado de todo Chile[cite: 3]
# Revisa los primeros resultados ordenados
head(arrange(inf_region, desc(total)), 3)                            # Muestra las 3 regiones más informales[cite: 3]
# 2. Construir el gráfico resaltando a Ñuble
grafico_2 <- inf_region |>
mutate(destacar = region_txt == "Ñuble") |>                              # Variable lógica: TRUE para Ñuble, FALSE el resto
ggplot(aes(x = total, y = reorder(region_txt, total), fill = destacar)) + # Ordena las barras de menor a mayor
geom_col(show.legend = FALSE) +                                          # Dibuja la altura ya calculada y oculta leyenda
scale_fill_manual(values = c(`TRUE` = "#e69b0a", `FALSE` = "grey75")) +  # Dorado para Ñuble, gris para el resto
geom_text(aes(label = round(total, 1)), hjust = -0.15, size = 3.3) +     # Escribe el valor al lado de cada barra
geom_vline(xintercept = inf_nacional, linetype = "dashed") +             # Línea punteada para el promedio nacional
annotate("text", x = inf_nacional + 0.5, y = 2, hjust = 0,               # Etiqueta de texto para la línea de referencia
label = "Promedio de Chile: 26,5 %") +
scale_x_continuous(limits = c(0, 40)) +                                  # Amplía el margen para que los números no se corten
labs(
title = "Ñuble es la segunda región con mayor informalidad laboral",
x = "% de ocupados informales",
y = NULL                                                               # Borra el nombre del eje Y
) +
theme_minimal(base_size = 13) +                                          # Tema base limpio sin chart junk
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),           # Título en negrita y color institucional
panel.grid.major.y = element_blank()                                   # Borra las líneas horizontales de fondo
)
grafico_2                                                                  # Imprime el gráfico en pantalla
# -------------------------------------------------------------------------
# Gráfico 3 · Distribución de horas habituales por sexo (ENE)
# -------------------------------------------------------------------------
# 1. Limpieza de datos: quitar centinelas
horas_limpias <- ocupados |>
mutate(habituales = na_if(na_if(habituales, 888), 999)) # Convierte los valores 888 y 999 en NA
# Opción A: Densidad (ideal para ver los picos exactos de 40 y 45 horas)
ggplot(horas_limpias, aes(x = habituales, fill = ifelse(mujer, "Mujer", "Hombre"), weight = fact_cal)) +
geom_density(alpha = 0.5) +                                            # Dibuja curvas semitransparentes[cite: 6]
scale_fill_manual(values = c("Mujer" = "#e69b0a", "Hombre" = "#223c6a")) + # Paleta accesible[cite: 4, 6]
labs(title = "Opción A: Densidad", x = "Horas semanales", fill = "Sexo") +
theme_minimal()
# Opción B: Boxplot (ideal para comparar medianas y ver valores atípicos/extremos)
ggplot(horas_limpias, aes(x = ifelse(mujer, "Mujer", "Hombre"), y = habituales, fill = ifelse(mujer, "Mujer", "Hombre"), weight = fact_cal)) +
geom_boxplot(show.legend = FALSE) +                                    # Dibuja cajas y oculta la leyenda redundante[cite: 6]
scale_fill_manual(values = c("Mujer" = "#e69b0a", "Hombre" = "#223c6a")) +
labs(title = "Opción B: Boxplot", x = NULL, y = "Horas semanales") +
theme_minimal()
# Opción A: Densidad (ideal para ver los picos exactos de 40 y 45 horas)
ggplot(horas_limpias, aes(x = habituales, fill = ifelse(mujer, "Mujer", "Hombre"), weight = fact_cal)) +
geom_density(alpha = 0.5) +                                            # Dibuja curvas semitransparentes[cite: 6]
scale_fill_manual(values = c("Mujer" = "#e69b0a", "Hombre" = "#223c6a")) + # Paleta accesible[cite: 4, 6]
labs(title = "Opción A: Densidad", x = "Horas semanales", fill = "Sexo") +
theme_minimal()
# Opción B: Boxplot (ideal para comparar medianas y ver valores atípicos/extremos)
ggplot(horas_limpias, aes(x = ifelse(mujer, "Mujer", "Hombre"), y = habituales, fill = ifelse(mujer, "Mujer", "Hombre"), weight = fact_cal)) +
geom_boxplot(show.legend = FALSE) +                                    # Dibuja cajas y oculta la leyenda redundante[cite: 6]
scale_fill_manual(values = c("Mujer" = "#e69b0a", "Hombre" = "#223c6a")) +
labs(title = "Opción B: Boxplot", x = NULL, y = "Horas semanales") +
theme_minimal()
grafico_3 <- ggplot(horas_limpias, aes(x = habituales, fill = sexo, weight = fact_cal)) +
geom_density(alpha = 0.5) +                                                    # Dibuja la densidad semitransparente[cite: 6]
scale_fill_manual(values = c("Mujeres" = "#e69b0a", "Hombres" = "#223c6a")) +  # Nombres en plural para que coincidan
scale_x_continuous(limits = c(0, 80)) +                                        # Enfoca el gráfico donde están los datos
labs(
title = "Las jornadas laborales se concentran fuertemente en 40 y 45 horas",
x = "Horas habituales por semana",
y = "Densidad",
fill = NULL
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),
legend.position = "bottom"
)
grafico_3
grafico_3 <- ggplot(horas_limpias, aes(x = habituales, fill = sexo, weight = fact_cal)) +
geom_density(alpha = 0.5) +                                                    # Dibuja la densidad semitransparente[cite: 6]
scale_fill_manual(values = c("Mujeres" = "#e69b0a", "Hombres" = "#223c6a")) +  # Nombres en plural para que coincidan
scale_x_continuous(limits = c(0, 80)) +                                        # Enfoca el gráfico donde están los datos
labs(
title = "Las jornadas laborales se concentran fuertemente en 40 y 45 horas",
x = "Horas habituales por semana",
y = "Densidad",
fill = NULL
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),
legend.position = "bottom"
)
grafico_3
scale_fill_manual(values = c("Mujeres" = "#e69b0a", "Hombres" = "#223c6a")) +  # Nombres en plural para que coincidan
grafico_3
# 2. Construir el gráfico de densidad
grafico_3 <- ggplot(horas_limpias, aes(x = habituales, fill = sexo, weight = fact_cal)) + # Mapea variables y ponderador[cite: 6]
geom_density(alpha = 0.5) +                                                    # Dibuja la curva semitransparente[cite: 6]
scale_fill_manual(values = c("Mujeres" = "#e69b0a", "Hombres" = "#223c6a")) +  # Colores manuales accesibles[cite: 4, 6]
scale_x_continuous(limits = c(0, 80)) +                                        # Enfoca el eje X en el rango útil
labs(
title = "Las jornadas laborales se concentran fuertemente en 40 y 45 horas", # Hallazgo del gráfico
x = "Horas habituales por semana",
y = "Densidad",
fill = NULL                                                                  # Oculta el título de la leyenda
) +
theme_minimal(base_size = 13) +                                                # Tema limpio[cite: 4]
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),                 # Título en negrita y color institucional[cite: 4]
legend.position = "bottom"                                                   # Leyenda en la parte inferior[cite: 4]
)
grafico_3                                                                        # Imprime el gráfico
# 2. Construir el gráfico de densidad
# 2. Construir el gráfico de densidad separando por sexo
grafico_3 <- horas_limpias |>
mutate(sexo_txt = ifelse(sexo == 1, "Hombres", "Mujeres")) |>                  # Transforma 1 y 2 en texto[cite: 7]
ggplot(aes(x = habituales, fill = sexo_txt, weight = fact_cal)) +              # Mapea el relleno a la nueva variable[cite: 7]
geom_density(alpha = 0.5) +
scale_fill_manual(values = c("Mujeres" = "#e69b0a", "Hombres" = "#223c6a")) +
scale_x_continuous(limits = c(0, 80)) +
labs(
title = "Las jornadas laborales se concentran fuertemente en 40 y 45 horas",
x = "Horas habituales por semana",
y = "Densidad",
fill = NULL
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),
legend.position = "bottom"
)
grafico_3                                                                        # Imprime el gráfico
# 1. Calcular la informalidad ponderada separada por sexo para cada región
inf_sexo_region <- ocupados |>
group_by(region_txt) |>
summarise(
hombres = 100 * weighted.mean(informal[!mujer], fact_cal[!mujer]),           # % de informalidad en hombres[cite: 3]
mujeres = 100 * weighted.mean(informal[mujer],  fact_cal[mujer])             # % de informalidad en mujeres[cite: 3]
)
# 2. Construir el gráfico de dispersión con ggrepel
grafico_4 <- ggplot(inf_sexo_region, aes(x = hombres, y = mujeres)) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "grey50") + # Línea diagonal de referencia y=x[cite: 3]
geom_point(color = "#223c6a", size = 2.5) +                                    # Dibuja los puntos institucionales[cite: 3]
geom_text_repel(aes(label = region_txt), size = 3, max.overlaps = Inf, seed = 1) + # Etiquetas que evitan pisarse[cite: 3]
labs(
title = "Las mujeres enfrentan mayor informalidad en casi todas las regiones", # Título tipo hallazgo[cite: 1]
x = "Informalidad hombres (%)",
y = "Informalidad mujeres (%)"
) +
theme_minimal(base_size = 13) +                                                # Tema limpio[cite: 4]
theme(plot.title = element_text(face = "bold", color = "#223c6a"))             # Título en negrita[cite: 4]
grafico_4
grafico_4
grafico_5 <- ocupados |>
filter(edad <= 80) |>                                                  # Filtra hasta los 80 años para evitar distorsiones en edades extremas
group_by(edad) |>
summarise(tasa = 100 * weighted.mean(informal, fact_cal)) |>           # Calcula la tasa ponderada para cada edad exacta
ggplot(aes(x = edad, y = tasa)) +
geom_line(color = "#223c6a", linewidth = 1) +                          # Dibuja la línea que forma la "U"
scale_y_continuous(limits = c(0, 50)) +                                # Fija el eje Y para mejor proporción
labs(
title = "La informalidad laboral es menor entre los 35 y 45 años",
x = "Edad",
y = "% de ocupados informales"
) +
theme_minimal(base_size = 13) +
theme(plot.title = element_text(face = "bold", color = "#223c6a"))
grafico_5
figura_final <- (grafico_2 | grafico_3) / grafico_4 +
plot_annotation(
title = "Radiografía del mercado laboral chileno: Informalidad y jornadas",
subtitle = "Análisis basado en la Encuesta Nacional de Empleo (trimestre MJJ)",
caption = "Elaboración propia para Fundamentos de Programación."
)
figura_final
figura_final <- (grafico_2 | grafico_3) / grafico_4 +
plot_annotation(
title = "Radiografía del mercado laboral chileno: Informalidad y jornadas",
subtitle = "Análisis basado en la Encuesta Nacional de Empleo (trimestre MJJ)",
caption = "Elaboración propia para Fundamentos de Programación."
)
figura_final
ggsave("figura_compuesta_t4.png", plot = figura_final, width = 12, height = 8, dpi = 300)
# Fundamentos de Programación para Análisis Económico
#
# Autor: Omar Aburto
# Fecha: 2026-11-03
#
# Objetivo: Analizar la distribución del ingreso (CASEN) y la informalidad
# laboral (ENE), justificando la elección de geometrías y componiendo una
# figura final con patchwork.
# =============================================================================
# 1. Carga de librerías
library(ggplot2)
library(dplyr)
library(patchwork)
library(scales)
library(ggrepel)
# Carga y limpieza
casen <- read.csv("data/raw/casen_reducido.csv") |> filter(!is.na(ingreso))
ene <- read.csv2("data/raw/ene-2026-06-mjj.csv") |> filter(activ == 1)
regiones <- c("Tarapacá", "Antofagasta", "Atacama", "Coquimbo", "Valparaíso",
"O'Higgins", "Maule", "Biobío", "La Araucanía", "Los Lagos",
"Aysén", "Magallanes", "Metropolitana", "Los Ríos",
"Arica y Parinacota", "Ñuble")
ocupados <- ene |>
mutate(informal   = ocup_form == 2,
mujer      = sexo == 2,
region_txt = regiones[region])
# -------------------------------------------------------------------------
# Gráfico 1 · Scatter CASEN
# -------------------------------------------------------------------------
grafico_1 <- ggplot(casen, aes(x = educ, y = ingreso, color = genero)) +
geom_point(size = 2, alpha = 0.7) +                                    # Dibuja los puntos
scale_color_manual(values = c("F" = "#e69b0a", "M" = "#223c6a")) +     # Fija colores manuales (dorado y azul institucional)
scale_y_continuous(
labels = label_currency(big.mark = ".", decimal.mark = ",")          # Eje Y en pesos chilenos
) +
labs(
title = "A mayor educación, mayor ingreso",
x = "Años de escolaridad",                                           # Etiqueta del eje X
y = NULL,                                                            # Oculta la etiqueta del eje Y (ya se entiende por el $)
color = NULL,                                                        # Oculta el título de la leyenda
caption = "Fuente: CASEN "                                           # Fuente de los datos
) +
theme_minimal(base_size = 11) +                                        # Tema limpio sin chart junk
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),         # Título principal en negrita y color azul
legend.position = "bottom"                                           # Mueve la leyenda abajo
)
grafico_1                                                                # Imprime el gráfico en pantalla
# -------------------------------------------------------------------------
# Gráfico 2 · Barras de informalidad por región (ENE)
# -------------------------------------------------------------------------
# 1. Preparar los datos y calcular promedios ponderados
inf_region <- ocupados |>
group_by(region_txt) |>                                            # Agrupa por región
summarise(total = 100 * weighted.mean(informal, fact_cal))         # Calcula el % ponderado por región
inf_nacional <- 100 * weighted.mean(ocupados$informal, ocupados$fact_cal) # Calcula el % ponderado de todo Chile
# Revisa los primeros resultados ordenados
head(arrange(inf_region, desc(total)), 3)                            # Muestra las 3 regiones más informales
# 2. Construir el gráfico resaltando a Ñuble
grafico_2 <- inf_region |>
mutate(destacar = region_txt == "Ñuble") |>                              # Variable lógica: TRUE para Ñuble, FALSE el resto
ggplot(aes(x = total, y = reorder(region_txt, total), fill = destacar)) + # Ordena las barras de menor a mayor
geom_col(show.legend = FALSE) +                                          # Dibuja la altura ya calculada y oculta leyenda
scale_fill_manual(values = c(`TRUE` = "#e69b0a", `FALSE` = "grey75")) +  # Dorado para Ñuble, gris para el resto
geom_text(aes(label = round(total, 1)), hjust = -0.15, size = 3.3) +     # Escribe el valor al lado de cada barra
geom_vline(xintercept = inf_nacional, linetype = "dashed") +             # Línea punteada para el promedio nacional
annotate("text", x = inf_nacional + 0.5, y = 2, hjust = 0,               # Etiqueta de texto para la línea de referencia
label = "Promedio de Chile: 26,5 %") +
scale_x_continuous(limits = c(0, 45)) +                                  # Amplía el margen para que los números no se corten
labs(
title = "Ñuble es la segunda región con\nmayor informalidad laboral",
x = "% de ocupados informales",
y = NULL                                                               # Borra el nombre del eje Y
) +
theme_minimal(base_size = 11) +                                          # Tema base limpio sin chart junk
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),           # Título en negrita y color institucional
panel.grid.major.y = element_blank()                                   # Borra las líneas horizontales de fondo
)
grafico_2                                                                  # Imprime el gráfico en pantalla
# 1. Limpieza de datos: quitar centinelas
horas_limpias <- ocupados |>
mutate(habituales = na_if(na_if(habituales, 888), 999))                        # Convierte los valores 888 y 999 en NA
# 2. Construir el gráfico de densidad separando por sexo
grafico_3 <- horas_limpias |>
mutate(sexo_txt = ifelse(sexo == 1, "Hombres", "Mujeres")) |>                  # Transforma 1 y 2 en texto
ggplot(aes(x = habituales, fill = sexo_txt, weight = fact_cal)) +              # Mapea el relleno a la nueva variable
geom_density(alpha = 0.5) +
scale_fill_manual(values = c("Mujeres" = "#e69b0a", "Hombres" = "#223c6a")) +
scale_x_continuous(limits = c(0, 80)) +
labs(
title = "Las jornadas laborales se concentran\nfuertemente en 40 y 45 horas",
x = "Horas habituales por semana",
y = "Densidad",
fill = NULL
) +
theme_minimal(base_size = 11) +
theme(
plot.title = element_text(face = "bold", color = "#223c6a"),
legend.position = "bottom"
)
grafico_3                                                                        # Imprime el gráfico
# 1. Calcular la informalidad ponderada separada por sexo para cada región
inf_sexo_region <- ocupados |>
group_by(region_txt) |>
summarise(
hombres = 100 * weighted.mean(informal[!mujer], fact_cal[!mujer]),           # % de informalidad en hombres
mujeres = 100 * weighted.mean(informal[mujer],  fact_cal[mujer])             # % de informalidad en mujeres
)
# 2. Construir el gráfico de dispersión con ggrepel
grafico_4 <- ggplot(inf_sexo_region, aes(x = hombres, y = mujeres)) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "grey50") + # Línea diagonal de referencia y=x
geom_point(color = "#223c6a", size = 2.5) +
geom_text_repel(aes(label = region_txt), size = 3, max.overlaps = Inf, seed = 1) + # Etiquetas que evitan pisarse
labs(
title = "Las mujeres enfrentan mayor informalidad en casi todas las regiones", # Título tipo hallazgo[cite: 1]
x = "Informalidad hombres (%)",
y = "Informalidad mujeres (%)"
) +
theme_minimal(base_size = 11) +
theme(plot.title = element_text(face = "bold", color = "#223c6a"))             # Título en negrita
grafico_4
grafico_5 <- ocupados |>
filter(edad <= 80) |>                                                  # Filtra hasta los 80 años para evitar distorsiones en edades extremas
group_by(edad) |>
summarise(tasa = 100 * weighted.mean(informal, fact_cal)) |>           # Calcula la tasa ponderada para cada edad exacta
ggplot(aes(x = edad, y = tasa)) +
geom_line(color = "#223c6a", linewidth = 1) +                          # Dibuja la línea que forma la "U"
scale_y_continuous(limits = c(0, 50)) +                                # Fija el eje Y para mejor proporción
labs(
title = "La informalidad laboral es menor entre los 35 y 45 años",
x = "Edad",
y = "% de ocupados informales"
) +
theme_minimal(base_size = 11) +
theme(plot.title = element_text(face = "bold", color = "#223c6a"))
grafico_5
figura_final <- (grafico_2 | grafico_3) / grafico_4 +
plot_annotation(
title = "Radiografía del mercado laboral chileno: Informalidad y jornadas",
subtitle = "Análisis basado en la Encuesta Nacional de Empleo (trimestre MJJ)",
caption = "Elaboración propia para Fundamentos de Programación."
)
figura_final
ggsave("figura_compuesta_t4.png", plot = figura_final, width = 12, height = 8, dpi = 300)
ggsave("outputs/figura_compuesta_t4.png", plot = figura_final, width = 12, height = 8, dpi = 300)
ggsave("outputs/grafico_5.png", plot = figura_final, width = 12, height = 8, dpi = 300)
ggsave("outputs/grafico_5.png", , width = 12, height = 8, dpi = 300)
ggsave("output/figuras/figura_compuesta_t4.pdf", plot = figura_final, width = 12, height = 8)
ggsave("output/figuras/figura_compuesta_t4.pdf", plot = figura_final, width = 12, height = 8)
ggsave("output/figura_compuesta_t4.pdf", plot = figura_final, width = 12, height = 8)
