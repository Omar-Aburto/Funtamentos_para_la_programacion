library(dplyr)
# Cargamos CASEN y creamos experiencia potencial (Mincer): edad - educ - 6
casen <- read.csv("data/raw/casen_reducido.csv") |>
mutate(experiencia = pmax(edad - educ - 6, 0))
educ
# ✏️ COMPLETA: el ingreso explicado por la educación. Lo que se quiere explicar
#    (Y) va a la IZQUIERDA del ~; lo que explica (X), a la derecha.
modelo <- lm(ingreso ~ educación, data = casen)
# ✏️ COMPLETA: el ingreso explicado por la educación. Lo que se quiere explicar
#    (Y) va a la IZQUIERDA del ~; lo que explica (X), a la derecha.
modelo <- lm(ingreso ~ educ, data = casen)
modelo                 # imprime solo los coeficientes
# 💡 El modelo es un OBJETO (una lista, Semana 4): se interroga con funciones.
# ✏️ COMPLETA con la función que corresponde: fitted() o residuals().
coef(modelo)               # los coeficientes estimados: b0 y b1
head(fitted(modelo), 3)      # el ingreso que PREDICE la recta para cada persona
head(residuals(modelo), 3)      # residuos = observado − predicho
library(dplyr)
library(broom)
library(modelsummary)
install.packages("modelsummary")
casen <- read.csv("data/raw/casen_reducido.csv") |>
mutate(experiencia = pmax(edad - educ - 6, 0))
m1 <- lm(ingreso ~ educ, data = casen)   # el modelo simple de la Sesión 1
m1 <- lm(ingreso ~ educ, data = casen)   # el modelo simple de la Sesión 1
# ✏️ COMPLETA: agrega `genero` al modelo (educ + experiencia + genero).
m2 <- lm(ingreso ~ educ + experiencia + ____, data = casen)
# ✏️ COMPLETA: agrega `genero` al modelo (educ + experiencia + genero).
m2 <- lm(ingreso ~ educ + experiencia + genero, data = casen)
round(coef(m2))
# 🔮 PREDICE: al agregar controles, ¿el coeficiente de educ SUBE, BAJA o se
#    queda casi igual respecto al modelo simple? Compáralos:
coef(m1)["educ"]    # modelo simple
coef(m2)["educ"]    # con controles
# ✏️ COMPLETA: coeficientes como tabla, PIDIENDO el intervalo de confianza al 95 %
tidy(m2, conf.int = ____)
# ✏️ COMPLETA: coeficientes como tabla, PIDIENDO el intervalo de confianza al 95 %
tidy(m2, conf.int = TRUE)
# ✏️ COMPLETA: arma la "tabla que importa":
#    sin intercepto, redondeada, con una columna lógica de significancia,
#    ordenada de lo más claro (p-value más chico) a lo menos claro.
tidy(m2, conf.int = TRUE) |>
filter(term != "(Intercept)") |>                       # quitar filas
mutate(across(c(estimate, conf.low, conf.high), round),
significativo = p.value < 0.05) |>            # umbral del 5 %
select(term, estimate, conf.low, conf.high, p.value, significativo) |>
arrange(p.value)                                        # ordenar por p-value
# ✏️ COMPLETA: del glance() saca r.squared, adj.r.squared, el error típico
#    de la predicción (en pesos), AIC y nobs.
glance(m2) |> select(r.squared, adj.r.squared, sigma, AIC, nobs)
# ✏️ COMPLETA: crea la variable y estima en un solo pipe.
m3 <- casen |>
mutate(superior = educ >= 13) |>
lm(ingreso ~ superior + experiencia + genero, data = )
# ✏️ COMPLETA: crea la variable y estima en un solo pipe.
m3 <- casen |>
mutate(superior = educ >= 13) |>
lm(ingreso ~ superior + experiencia + genero, data =casen)
# ✏️ COMPLETA: crea la variable y estima en un solo pipe.
m3 <- casen |>
mutate(superior = educ >= 13) |>
lm(ingreso ~ superior + experiencia + genero, data =casen)
# ✅ Deberías ver: fitted 625452.5 709612.2 415053.1 | residuos -105452 -242612 -52053
#
# 🔮 PREDICE: la persona 1 tiene 12 años de educación y gana $520.000.
#    Calcula A MANO el ingreso que le predice la recta. ¿Coincide con fitted()?
coef(modelo)[1] + coef(modelo)[2] * 12
coef(modelo)[1]
coef(modelo)[2]
# 💡 El modelo es un OBJETO (una lista, Semana 4): se interroga con funciones.
# ✏️ COMPLETA con la función que corresponde: fitted() o residuals().
coef(modelo)               # los coeficientes estimados: b0 y b1
head(fitted(modelo), 3)      # el ingreso que PREDICE la recta para cada persona
head(residuals(modelo), 3)      # residuos = observado − predicho
# -----------------------------------------------------------------------------
# BLOQUE B — El output de summary()
# -----------------------------------------------------------------------------
# 🔵 CORRE Y OBSERVA: el reporte completo
summary(modelo)
# ✏️ COMPLETA: extrae solo el coeficiente de educación, por su NOMBRE.
coef(modelo)["educ"]
# ✏️ COMPLETA: extrae el R² del modelo (pista: summary() es una LISTA, Semana 4).
summary(modelo)$r.square
# 🔮 PREDICE: en la Semana 7 la correlación educ-ingreso fue 0,677. Elévala al
#    cuadrado. ¿Qué número obtienes? __________
#    Pista: ingreso tiene NA; el argumento de cor() que los descarta es de la
#    Semana 7.
cor(casen$educ, casen$ingreso, use = "complete.obs")^2
# -----------------------------------------------------------------------------
# BLOQUE C — Interpretación
# -----------------------------------------------------------------------------
# 🔵 CORRE Y OBSERVA
round(coef(modelo))     # intercepto y pendiente, redondeados
# 🟢 TU TURNO: ¿cuánto más predice la recta para alguien con 16 años de
#    educación que para alguien con 12? Usa solo la pendiente.
4 * coef(modelo)["educ"]
# ✏️ COMPLETA: la tabla de coeficientes con sus p-values (¿el efecto es
#    distinto de cero?). Es otro elemento de la lista summary(): mira names().
names(summary(modelo))
summary(modelo)$coefficients      # una MATRIZ: filas = coeficientes; columnas =
round(summary(m1)$r.square, 3)          # cuánto explica el modelo
# -----------------------------------------------------------------------------
# BLOQUE D — Ejemplo completo + forma log (Mincer)
# -----------------------------------------------------------------------------
# ✏️ COMPLETA: el ejemplo completo, de la estimación a los dos números clave.
m1 <- lm(ingreso ~ educ, data = ____)
# -----------------------------------------------------------------------------
# BLOQUE D — Ejemplo completo + forma log (Mincer)
# -----------------------------------------------------------------------------
# ✏️ COMPLETA: el ejemplo completo, de la estimación a los dos números clave.
m1 <- lm(ingreso ~ educ, data = casen)
round(coef(m1)["educ"])             # pesos por año de educación
round(summary(m1)$r.square, 3)          # cuánto explica el modelo
# ✏️ COMPLETA: forma log. El ingreso entra en LOGARITMO -> el coeficiente se
#    lee como % (Mincer).
m_log <- lm(____(ingreso) ~ educ, data = casen)
# ✏️ COMPLETA: forma log. El ingreso entra en LOGARITMO -> el coeficiente se
#    lee como % (Mincer).
m_log <- lm(log(ingreso) ~ educ, data = casen)
round(coef(m_log)["educ"], 3)       # ≈ retorno porcentual por año
# 🟢 TU TURNO: estima `ingreso ~ experiencia`. ¿El R² es mayor o menor que el de
#    educación? ¿Qué te dice eso sobre cuál variable explica más el ingreso?
m_exp <- lm(ingreso ~ ____, data = casen)
# 🟢 TU TURNO: estima `ingreso ~ experiencia`. ¿El R² es mayor o menor que el de
#    educación? ¿Qué te dice eso sobre cuál variable explica más el ingreso?
m_exp <- lm(ingreso ~ educ, data = casen)
round(summary(m_exp)$r.squared, 3)
# 🟢 TU TURNO: estima `ingreso ~ experiencia`. ¿El R² es mayor o menor que el de
#    educación? ¿Qué te dice eso sobre cuál variable explica más el ingreso?
m_exp <- lm(ingreso ~ experiencia, data = casen)
round(summary(m_exp)$r.squared, 3)
library(dplyr)
library(broom)
library(modelsummary)
casen <- read.csv("data/raw/casen_reducido.csv") |>
mutate(experiencia = pmax(edad - educ - 6, 0))
m1 <- lm(ingreso ~ educ, data = casen)   # el modelo simple de la Sesión 1
# ✏️ COMPLETA: agrega `genero` al modelo (educ + experiencia + genero).
m2 <- lm(ingreso ~ educ + experiencia + genero, data = casen)
round(coef(m2))
# 🔮 PREDICE: al agregar controles, ¿el coeficiente de educ SUBE, BAJA o se
#    queda casi igual respecto al modelo simple? Compáralos:
coef(m1)["educ"]    # modelo simple
coef(m2)["educ"]    # con controles
# ✏️ COMPLETA: coeficientes como tabla, PIDIENDO el intervalo de confianza al 95 %
tidy(m2, conf.int = TRUE)
# ✏️ COMPLETA: arma la "tabla que importa":
#    sin intercepto, redondeada, con una columna lógica de significancia,
#    ordenada de lo más claro (p-value más chico) a lo menos claro.
tidy(m2, conf.int = TRUE) |>
filter(term != "(Intercept)") |>                       # quitar filas
mutate(across(c(estimate, conf.low, conf.high), round),
significativo = p.value < 0.05) |>            # umbral del 5 %
select(term, estimate, conf.low, conf.high, p.value, significativo) |>
arrange(p.value)                                        # ordenar por p-value
# ✏️ COMPLETA: del glance() saca r.squared, adj.r.squared, el error típico
#    de la predicción (en pesos), AIC y nobs.
glance(m2) |> select(r.squared, adj.r.squared, sigma, AIC, nobs)
# ✏️ COMPLETA: crea la variable y estima en un solo pipe.
m3 <- casen |>
mutate(superior = educ >= 13) |>
lm(ingreso ~ superior + experiencia + genero, data =casen)
# ✏️ COMPLETA: crea la variable y estima en un solo pipe.
m3 <- casen |>
mutate(superior = educ >= 13) |>
lm(ingreso ~ superior + experiencia + genero, data =casen)
mutate(superior = educ >= 13) |>
# ✏️ COMPLETA: crea la variable y estima en un solo pipe.
m3 <- casen |>
mutate(superior = educ >= 13)
# ✏️ COMPLETA: crea la variable y estima en un solo pipe.
m3 <- casen |>
mutate(superior = educ >= 13) |>
lm(ingreso ~ superior + experiencia + genero, data =casen)
# ✏️ COMPLETA: crea la variable y estima en un solo pipe.
m3 <- casen |>
mutate(superior = educ >= 13) |>
lm(ingreso ~ superior + experiencia + genero, data =_)
tidy(m3) |> select(term, estimate, p.value) |> mutate(estimate = round(estimate))
# 🔵 CORRE Y OBSERVA: tres modelos guardados en una LISTA con nombre
#    (antes, completa el hueco del tercer modelo)
modelos <- list(
simple    = lm(ingreso ~ educ, data = casen),
controles = lm(ingreso ~ educ + experiencia + genero, data = casen),
mincer    = lm(ingreso ~ educ + experiencia + ____(experiencia^2) + genero, data = casen)
# 🔵 CORRE Y OBSERVA: tres modelos guardados en una LISTA con nombre
#    (antes, completa el hueco del tercer modelo)
modelos <- list(
simple    = lm(ingreso ~ educ, data = casen),
controles = lm(ingreso ~ educ + experiencia + genero, data = casen),
mincer    = lm(ingreso ~ educ + experiencia + I(experiencia^2) + genero, data = casen)
)
# ✏️ COMPLETA: aplica glance() a cada modelo y apílalos con una columna
#    que diga de qué modelo viene cada fila.
lapply(modelos, glance) |>
bind_rows(.id =  = "modelo") |>
# ✏️ COMPLETA: aplica glance() a cada modelo y apílalos con una columna
#    que diga de qué modelo viene cada fila.
lapply(modelos, glance) |>
bind_rows(.id = "modelo") |>
select(modelo, r.squared, adj.r.squared, AIC, nobs)
# ✏️ COMPLETA: ¿cambió el coeficiente de educ entre los tres modelos?
bind_rows(simple    = tidy(modelos$simple),
controles = tidy(modelos$controles),
mincer    = tidy(modelos$mincer), .id = "modelo") |>
filter(term == "educ") |>
select(modelo, estimate, std.error, p.value)
# Un control mueve un coeficiente solo si se relaciona A LA VEZ con la
# educación y con el ingreso. ¿Se relaciona la experiencia con la educación?
cor(casen$educ, casen$experiencia)
# ✏️ COMPLETA: una regresión POR GRUPO (misma idea que correlacion_por_grupo()
#    de la Semana 7). Dentro de group_modify(), los datos de cada grupo se
#    llaman .x
casen |>
group_by(genero) |>
group_modify(~ tidy(lm(ingreso ~ educ, data = .x))) |>
filter(term == "educ") |>
select(genero, estimate, std.error, p.value)
# -----------------------------------------------------------------------------
# BLOQUE D — Diagnósticos
# -----------------------------------------------------------------------------
# ✏️ COMPLETA: augment() = una fila por persona, con lo predicho y el residuo.
#    Ordena por el TAMAÑO del residuo (sin importar el signo) para encontrar a
#    los peor predichos.
augment(m2) |>
select(ingreso, educ, genero, .fitted, .resid) |>
mutate(across(c(.fitted, .resid), round)) |>
arrange(desc(abs(.resid))) |>
head(3)
# Predecir PERFILES concretos (deben tener las mismas columnas que el modelo):
perfiles <- tibble(educ        = c(12, 16, 16),
experiencia = 10,
genero      = c("F", "F", "M"))
View(perfiles)
# ✏️ COMPLETA: ¿qué datos nuevos le pasas a predict()?
perfiles |> mutate(ingreso_predicho = round(predict(m2, newdata = perfiles)))
# -----------------------------------------------------------------------------
# BLOQUE E — Comunicar: tablas profesionales
# -----------------------------------------------------------------------------
# ✏️ COMPLETA: los dos modelos lado a lado, con estrellas de significancia
#    (esto pide la T3)
modelsummary(list("Simple" = m1, "Múltiple" = m2),
stars = TRUE,
gof_map = c("nobs", "r.squared"))
