library(dplyr)
library(tidyr)      # pivot_longer() (Semana 6)
library(ggplot2)
library(ggrepel)    # etiquetas que no se pisan (Bloque E)
install.packages("ggrepel")
library(ggrepel)    # etiquetas que no se pisan (Bloque E)
casen <- read.csv("data/raw/casen_reducido.csv") |>
mutate(experiencia = pmax(edad - educ - 6, 0))
casen <- read.csv("data/raw/casen_reducido.csv") |>
mutate(experiencia = pmax(edad - educ - 6, 0))
salario <- read.csv("data/raw/salario_minimo_chile.csv")       # Semana 2
ene <- read.csv2("data/raw/ene-2026-06-mjj.csv")                # Semana 6 (2-3 s)
# 🔵 CORRE Y OBSERVA
ggplot(data = casen, aes(x = educ, y = ingreso)) +
geom_point()
# 🔮 PREDICE: ¿qué pasa si corro solo la primera parte, sin el geom?
ggplot(casen, aes(x = educ, y = ingreso))
# 🔵 CORRE Y OBSERVA
ggplot(data = casen, aes(x = educ, y = ingreso)) +
geom_point() +
geom_smooth(method = "lm", se = F, colo = oro)  # + capa tendencia
# 🔵 CORRE Y OBSERVA
ggplot(data = casen, aes(x = educ, y = ingreso)) +
geom_point() +
geom_smooth(method = "lm", se = F, colo = ore)  # + capa tendencia
# 🔵 CORRE Y OBSERVA
ggplot(data = casen, aes(x = educ, y = ingreso)) +
geom_point() +
geom_smooth(method = "lm", se = F, color = oro)  # + capa tendencia
## El gráfico es un OBJETO: guardarlo y sumarle capas
# 🔵 CORRE Y OBSERVA: al guardarlo con <- no se dibuja; al escribir su nombre, sí.
p <- ggplot(casen, aes(educ, ingreso)) +
geom_point(color = "#223c6a")
p
p
# ✏️ COMPLETA: súmale la recta de regresión sin repetir lo anterior.
p + geom_smooth(method = "lm", se = FALSE, color = "#e69b0a")
# 🔮 PREDICE: después de la línea anterior, ¿p tiene la recta o no? Corre p. ____
p
# -----------------------------------------------------------------------------
# BLOQUE B — Aesthetics: mapear vs fijar (el error #1)
# -----------------------------------------------------------------------------
# MAPEAR = el color depende de una VARIABLE -> DENTRO de aes()
# 🔵 CORRE Y OBSERVA
ggplot(casen, aes(x = educ, y = ingreso, color = genero)) +
geom_point()
# FIJAR = el color es una decisión tuya -> FUERA de aes()
# 🔵 CORRE Y OBSERVA
ggplot(casen, aes(x = educ, y = ingreso)) +
geom_point(color = "#223c6a", size = 3, alpha = 0.6)
# 🔮 PREDICE antes de correr: ¿de qué color saldrán estos puntos?
#    Tu predicción: ____________
ggplot(casen, aes(x = educ, y = ingreso, color = "azul")) +
geom_point()
# 🔮 PREDICE: ¿cuántas rectas de regresión dibuja este gráfico? ____
ggplot(casen, aes(educ, ingreso, color = genero)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE)
# ✏️ COMPLETA: ahora quiero los puntos por género pero UNA sola recta.
#    Mueve el color a la capa de puntos.
ggplot(casen, aes(educ, ingreso)) +
geom_point(aes(color = genero)) +
geom_smooth(method = "lm", se = FALSE, color = "black")
# ✏️ COMPLETA: pasa a formato largo y dibuja una línea por serie.
salario |>
mutate(Real = salario_minimo / ipc * 100) |>
select(anio, Nominal = salario_minimo, Real) |>
pivot_longer(-anio, names_to = "serie", values_to = "pesos") |>
ggplot(aes(anio, pesos, color = serie)) +
geom_line(linewidth = 1.2)
## geom_col() vs geom_bar(): la confusión clásica
resumen <- casen |>
group_by(sector) |>
summarise(ing = mean(ingreso, na.rm = TRUE), .groups = "drop")
# ✏️ COMPLETA: geom_col() dibuja la altura que YO ya calculé.
ggplot(resumen, aes(x = reorder(sector, ing), y = ing)) +
geom_col(fill = "#223c6a") +
coord_flip()
# 🔵 CORRE Y OBSERVA — geom_bar() en cambio CUENTA las filas
ggplot(casen, aes(x = sector)) +
geom_bar(fill = "#e69b0a")
# -----------------------------------------------------------------------------
# BLOQUE D — labs(): el texto que comunica
# -----------------------------------------------------------------------------
# 🟢 TU TURNO: completa las etiquetas. Fíjate bien en el título.
ggplot(casen, aes(educ, ingreso, color = genero)) +
geom_point(alpha = 0.6) +
geom_smooth(method = "lm", se = FALSE) +
labs(
title    = "A mayor educación, mayor ingreso", # ¡el HALLAZGO, no las variables!
subtitle = "Trabajadores ocupados · muestra reducida CASEN",
x        = "Años de escolaridad",
y        = "Ingreso en ($)",                      # no olvides la unidad ($)
color    = "Género",
caption  = "Fuente: elaboración propia"               # la fuente SIEMPRE
) +
scale_y_continuous(labels = scales::label_number(big.mark = ".", decimal.mark = ",")) +
theme_minimal()
# ✏️ COMPLETA: guarda la figura en disco (nunca con captura de pantalla).
dir.create("output/figuras", recursive = TRUE, showWarnings = FALSE)   # crea la carpeta si no existe
ggsave("output/figuras/mi_grafico.png", width = 8, height = 5, dpi = 300)
# -----------------------------------------------------------------------------
# BLOQUE E — El rediseño de la Semana 9, en código (ENE)
# -----------------------------------------------------------------------------
regiones <- c("Tarapacá", "Antofagasta", "Atacama", "Coquimbo", "Valparaíso",
"O'Higgins", "Maule", "Biobío", "La Araucanía", "Los Lagos",
"Aysén", "Magallanes", "Metropolitana", "Los Ríos",
"Arica y Parinacota", "Ñuble")
# ✏️ COMPLETA: informalidad PONDERADA por región, total y por sexo (S6 y S7).
inf_region <- ene |>
filter(activ == 1) |>                                    # ocupados
mutate(informal   = ocup_form == 2,                   # 2 = informal
mujer      = sexo == 2,
region_txt = regiones[region]) |>
group_by(region_txt) |>
summarise(total   = 100 * weighted.mean(informal, fact_cal),
hombres = 100 * weighted.mean(informal[!mujer], fact_cal[!mujer]),
mujeres = 100 * weighted.mean(informal[mujer],  fact_cal[mujer]))
inf_nacional <- 26.5                                       # % de Chile, ponderado
head(arrange(inf_region, desc(total)), 3)
## Paso 1 · Resaltar un grupo: una columna lógica mapeada a fill
# ✏️ COMPLETA: destaca Ñuble en dorado; el resto en gris.
p1 <- inf_region |>
mutate(destacar = region_txt == "Ñuble") |>
ggplot(aes(total, reorder(region_txt, total), fill = destacar)) +
geom_col() +
scale_fill_manual(values = c(`TRUE` = "#e69b0a", `FALSE` = "grey75"),
guide = "none") +
labs(x = "% de ocupados informales", y = NULL)
p1
## Paso 2 · Valores escritos y una línea de referencia
# ✏️ COMPLETA: escribe cada valor y marca el promedio nacional.
p1 +
geom_text(aes(label = round(total, 1)), hjust = -0.15, size = 3.3) +
geom_vline(xintercept = inf_nacional, linetype = "dashed") +
annotate("text", x = inf_nacional + 0.5, y = 2, hjust = 0,
label = "Promedio de Chile: 26,5 %") +
scale_x_continuous(limits = c(0, 40))
# -----------------------------------------------------------------------------
# 📦 PAQUETES DE HOY
# -----------------------------------------------------------------------------
# Si es la primera vez que los usas:
install.packages(c("patchwork", "scales"))
library(dplyr)
library(ggplot2)
library(scales)
library(patchwork)
azul <- "#223c6a"; oro <- "#e69b0a"
casen   <- read.csv("data/raw/casen_reducido.csv")
salario <- read.csv("data/raw/salario_minimo_chile.csv")
ene     <- read.csv2("data/raw/ene-2026-06-mjj.csv")         # 2-3 segundos
# 🔵 CORRE Y OBSERVA: el gráfico sin escalas propias
ggplot(casen, aes(educ, ingreso)) + geom_point(color = azul)
# ✏️ COMPLETA: eje X con marcas cada 2 años; eje Y desde 0.
ggplot(casen, aes(educ, ingreso)) +
geom_point(color = azul) +
scale_x_continuous(name = "Años de educación", breaks = seq(6, 20, 2)) +
scale_y_continuous(name = "Ingreso mensual", limits = c(0, 1200000))
## El paquete scales: los label_*() fabrican un FORMATEADOR -----------------
# Un formateador es una FUNCIÓN: recibe números y devuelve texto.
pesos <- c(529000, 1250000, 9314017)
# 🔵 CORRE Y OBSERVA
label_currency(big.mark = ".", decimal.mark = ",")(pesos)
# ✏️ COMPLETA: los mismos números en miles ("529 mil").
label_number(scale = 1e-3, suffix = " mil", big.mark = ".", decimal.mark = ",")(pesos)
# 🔵 CORRE Y OBSERVA: mil y millones automáticos
label_number(scale_cut = c(0, " mil" = 1e3, " MM" = 1e6),
big.mark = ".", decimal.mark = ",", accuracy = 0.1)(pesos)
# ✏️ COMPLETA: dólares y porcentajes.
label_currency(prefix = "US$")(c(560, 1200))
label_percent(accuracy = 0.1, decimal.mark = ",", suffix = " %")(c(0.265, 0.345))
# 🔮 PREDICE: ¿qué pasa si escribes label_number(big.mark = ".") sin
#    decimal.mark? Pruébalo. ____
label_number(big.mark = ".")(1234.5)
## Color mapeado: _d (discreto) o _c (continuo) --------------------------------
# 🔵 CORRE Y OBSERVA: color según una CATEGORÍA (sector) -> escala discreta
ggplot(casen, aes(educ, ingreso, color = sector)) +
geom_point(size = 2) +
scale_color_viridis_d()
# ✏️ COMPLETA: color según una MAGNITUD (edad) -> escala continua.
ggplot(casen, aes(educ, ingreso, color = edad)) +
geom_point(size = 2) +
scale_alpha_viridis_()             # pista: scale_color_viridis_?()
# ✏️ COMPLETA: color según una MAGNITUD (edad) -> escala continua.
ggplot(casen, aes(educ, ingreso, color = edad)) +
geom_point(size = 2) +
scale_alpha_viridis_c()             # pista: scale_color_viridis_?()
# ✏️ COMPLETA: color según una MAGNITUD (edad) -> escala continua.
ggplot(casen, aes(educ, ingreso, color = edad)) +
geom_point(size = 2) +
scale_color_viridis_c()             # pista: scale_color_viridis_?()
## Paletas en código (Semana 9) -------------------------------------------------
ocupados <- ene |>
filter(activ == 1) |>
mutate(sexo = ifelse(sexo == 1, "Hombre", "Mujer"),
categoria = case_when(categoria_ocupacion == 3 ~ "Asal. privado",
categoria_ocupacion == 4 ~ "Asal. público",
categoria_ocupacion == 2 ~ "Cuenta propia",
TRUE                     ~ "Otras"))
base <- ggplot(ocupados, aes(y = categoria, fill = categoria, weight = fact_cal)) +
geom_bar(show.legend = FALSE) + labs(x = NULL, y = NULL)
# ✏️ COMPLETA: tres formas de elegir los colores.
base + scale_fill_brewer(palette = "set2")
# ✏️ COMPLETA: tres formas de elegir los colores.
base + scale_fill_brewer(palette = "set2")
base + scale_fill_manual(values = unname(palette.colors(5, "Okabe-Ito"))[-1])
base + scale_fill_viridis_d() + labs(title = "scale_fill_viridis_d"))
base + scale_fill_viridis_d() + labs(title = "scale_fill_viridis_d()")
# -----------------------------------------------------------------------------
# BLOQUE B — Stats, posiciones y coordenadas
# -----------------------------------------------------------------------------
## Stats: geom_bar() CUENTA filas ----------------------------------------------
# 🔵 CORRE Y OBSERVA: cuenta personas ENCUESTADAS (la muestra)
ggplot(ocupados, aes(y = categoria)) + geom_bar()
nrow(ocupados)
# ✏️ COMPLETA: con weight, el stat SUMA los pesos (la población, Semana 6).
ggplot(ocupados, aes(y = categoria, weight = 8)) + geom_bar(fill = azul)
# ✏️ COMPLETA: con weight, el stat SUMA los pesos (la población, Semana 6).
ggplot(ocupados, aes(y = categoria, weight = 2)) + geom_bar(fill = azul)
# ✏️ COMPLETA: con weight, el stat SUMA los pesos (la población, Semana 6).
ggplot(ocupados, aes(y = categoria, weight = 10)) + geom_bar(fill = azul)
sum(ocupados$fact_cal)
# ✏️ COMPLETA: con weight, el stat SUMA los pesos (la población, Semana 6).
ggplot(ocupados, aes(y = categoria, weight = )) + geom_bar(fill = azul)
# ✏️ COMPLETA: con weight, el stat SUMA los pesos (la población, Semana 6).
ggplot(ocupados, aes(y = categoria, weight = fact_cal)) + geom_bar(fill = azul)
sum(ocupados$fact_cal)
## Posiciones: stack, dodge, fill ---------------------------------------------
base2 <- ggplot(ocupados, aes(sexo, fill = categoria, weight = fact_cal)) +
scale_fill_brewer(palette = "Set2") + labs(x = NULL, y = NULL, fill = NULL)
base2 + geom_bar(position = "stack")       # totales
base2 + geom_bar(position = "dodge")       # lado a lado
# ✏️ COMPLETA: cada barra suma 100 % (el prop.table(margin = 1) de la Semana 7).
base2 + geom_bar(position = "fill") + scale_y_continuous(labels = label_percent())
# 🔵 CORRE Y OBSERVA: las proporciones que dibuja "fill"
ocupados |>
group_by(sexo, categoria) |>
summarise(pob = sum(fact_cal), .groups = "drop") |>
group_by(sexo) |>
mutate(pct = round(100 * pob / sum(pob), 1))
## Coordenadas: zoom no es lo mismo que cortar --------------------------------
g <- ggplot(casen, aes(educ, ingreso)) +
geom_point(color = "grey60") +
geom_smooth(method = "lm", se = FALSE, color = oro)
# 🔮 PREDICE: ¿la recta será la misma en los dos gráficos? ____
g + ylim(400000, 800000)                          # escala: BORRA lo de afuera
g + coord_cartesian(ylim = c(400000, 800000))     # coordenada: solo acerca
g
g + coord_cartesian(ylim = c(400000, 800000))     # coordenada: solo acerca
# 🔵 CORRE Y OBSERVA: la cuenta que hace ylim() a escondidas
coef(lm(ingreso ~ educ, data = casen))
coef(lm(ingreso ~ educ, data = filter(casen, ingreso >= 400000, ingreso <= 800000)))
# -----------------------------------------------------------------------------
# BLOQUE C — Facetas: un panel por grupo
# -----------------------------------------------------------------------------
# ✏️ COMPLETA: horas promedio (ponderadas, sin centinelas) por tramo de 5 años
#    de edad y categoría ocupacional.
horas_edad <- ene |>
filter(activ == 1, edad <= 75) |>
mutate(horas = na_if(na_if(habituales, 888), 999),
categoria = case_when(categoria_ocupacion == 3      ~ "Asalariado privado",
categoria_ocupacion == 4      ~ "Asalariado público",
categoria_ocupacion == 2      ~ "Cuenta propia",
categoria_ocupacion == 1      ~ "Empleador",
categoria_ocupacion %in% 5:6  ~ "Servicio doméstico",
TRUE                          ~ "Familiar no remunerado"),
edad = pmin(floor(edad / 5) * 5, 70) + 2.5) |>      # punto medio del tramo
group_by(categoria, edad) |>
summarise(horas = weighted.mean(horas, fact_cal, na.rm = TRUE),
n = n(), .groups = "drop") |>
filter(n >= 10)
